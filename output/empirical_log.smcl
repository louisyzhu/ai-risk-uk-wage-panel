{com}. 
. *-----------------------------------------------------------------
. * 1. Build occupation-year wage panel
. *-----------------------------------------------------------------
. tempfile wages
{txt}
{com}. save `wages', emptyok
{txt}(dataset contains 0 observations)
{p 0 4 2}
file {bf}
/var/folders/8g/x3dsynzs48dd759mf0c_n0th0000gn/T//S_69201.000001{rm}
saved
as .dta format
{p_end}

{com}. 
. local years 2014/2023
{txt}
{com}. foreach y of numlist `years' {c -(}
{txt}  2{com}. 
.     import excel using "ashe_`y'.xls", ///
>         sheet("All") firstrow cellrange(A5:F500) clear   // header row 5
{txt}  3{com}. 
.     keep Code Mean                       // two columns we need
{txt}  4{com}.     rename (Code Mean) (soc wage)
{txt}  5{com}. 
.     destring soc,  replace
{txt}  6{com}.     destring wage, replace ignore("x")
{txt}  7{com}.     drop if missing(soc) | missing(wage)
{txt}  8{com}. 
.     gen year  = `y'
{txt}  9{com}.     gen lnwage = ln(wage)
{txt} 10{com}. 
.     append using `wages'
{txt} 11{com}.     save `wages', replace
{txt} 12{com}. {c )-}
