{com}. 
. *-----------------------------------------------------------------
. * 2. Merge automation-risk scores  (final, tested names)
. *-----------------------------------------------------------------
. import excel using "Automation risk by occupation.xlsx", ///
>        sheet("Sheet1") firstrow clear
{res}{text}(4 vars, 369 obs)

{com}. rename _all, lower
{res}{txt}
{com}. 
. keep soc2010 probabilityofautomation
{txt}
{com}. rename (soc2010 probabilityofautomation) (soc risk)
{res}{txt}
{com}. destring soc, replace
{txt}soc already numeric; no {res}replace
{txt}
{com}. 
. merge 1:m soc using `wages', keep(match) nogen
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}               0
{txt}{col 5}Matched{col 30}{res}           3,255{txt}  
{col 5}{hline 41}

{com}. save "data_work/panel.dta", replace
{txt}{p 0 4 2}
(file {bf}
data_work/panel.dta{rm}
not found)
{p_end}
{p 0 4 2}
file {bf}
data_work/panel.dta{rm}
saved
{p_end}

{com}. 
. 
. *-----------------------------------------------------------------
. * 3. Fixed-effects regression
. *-----------------------------------------------------------------
. xtset soc year
{res}
{col 1}{txt:Panel variable: }{res:soc}{txt: (unbalanced)}
{p 1 16 2}{txt:Time variable: }{res:year}{txt:, }{res:{bind:2014}}{txt: to }{res:{bind:2023}}{txt:, but with gaps}{p_end}
{txt}{col 10}Delta: {res}1 unit
{txt}
{com}. gen post2016 = year >= 2016
{txt}
{com}. xtreg lnwage c.risk##i.post2016 i.year, fe cluster(soc)
{txt}{p 0 6 2}note: {bf:risk} omitted because of collinearity.{p_end}
{p 0 6 2}note: {bf:2023.year} omitted because of collinearity.{p_end}
